generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  OWNER
  MANAGER
  SALES_REP
  PROJECT_MANAGER
  FIELD_CREW
  OFFICE_ADMIN
}

enum LeadSource {
  WEBSITE
  PHONE
  REFERRAL
  STORM_EVENT
  MANUAL
  IMPORT
  MARKETING_QR
}

enum LeadStatus {
  NEW
  CONTACTED
  INSPECTION_SCHEDULED
  ESTIMATE_SENT
  WON
  LOST
}

enum JobStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum JobPhase {
  INSPECTION
  ESTIMATE
  PRODUCTION
  INVOICING
  COMPLETED
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum EventType {
  INSPECTION
  PRODUCTION
  ESTIMATE
  MEETING
  OTHER
}

enum IntegrationType {
  QUICKBOOKS
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  HOVER
  EAGLEVIEW
  ABC_SUPPLY
  WEBHOOK
}

enum IntegrationStatus {
  ACTIVE
  PENDING
  ERROR
  DISCONNECTED
}

enum NotificationType {
  JOB_UPDATE
  ESTIMATE_APPROVED
  ESTIMATE_REJECTED
  FEED_MENTION
  FEED_REPLY
  SCHEDULE_CHANGE
  STORM_ALERT
  MATERIAL_ORDER
  CHANGE_ORDER
  GENERAL
}

enum MaterialStatus {
  PENDING
  ORDERED
  DELIVERED
  BACKORDERED
  CANCELLED
}

enum SeverityLevel {
  MINOR
  MODERATE
  SEVERE
  EXTREME
}

enum StormEventType {
  TORNADO
  HURRICANE
  SEVERE_THUNDERSTORM
  FLASH_FLOOD
  WINTER_STORM
  WILDFIRE
}

// ============================================================
// Core Models
// ============================================================

model User {
  id           String   @id @default(uuid())
  companyId    String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id])
  leads                    Lead[]                    @relation("AssignedLeads")
  jobs                     Job[]                     @relation("AssignedJobs")
  calendarEvents           CalendarEvent[]
  eventAssignees           CalendarEventAssignee[]
  jobAssignees             JobAssignee[]
  feedPosts                FeedPost[]
  feedAttachments          FeedAttachment[]
  feedMentions             FeedMention[]
  notifications            Notification[]
  documents                Document[]
  materialOrders           MaterialOrder[]
  subcontractorAssignments SubcontractorAssignment[]
  changeOrders             ChangeOrder[]
}

model Company {
  id               String   @id @default(uuid())
  name             String
  address          String?
  phone            String?
  logoUrl          String?
  subscriptionTier String   @default("Starter")
  settings         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                User[]
  leads                Lead[]
  jobs                 Job[]
  estimates            Estimate[]
  calendarEvents       CalendarEvent[]
  feedPosts            FeedPost[]
  feedAttachments      FeedAttachment[]
  documents            Document[]
  notifications        Notification[]
  integrations         Integration[]
  stormEvents          StormEvent[]
  priceDatabaseEntries PriceDatabaseEntry[]
  materialOrders       MaterialOrder[]
  subcontractors       Subcontractor[]
  changeOrders         ChangeOrder[]
  marketingCampaigns   MarketingCampaign[]
  marketingPieces      MarketingPiece[]
}

model Lead {
  id               String     @id @default(uuid())
  companyId        String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  propertyAddress  String
  propertyLatLng   Json?
  source           LeadSource
  status           LeadStatus @default(NEW)
  assignedToUserId String?
  stormEventId     String?
  score            Int?
  notes            String?
  jobId            String?    @unique
  // Storm-intelligence scoring (computed by the NOAA impact engine)
  stormImpactScore Int?
  stormScoredAt    DateTime?
  // Marketing Studio attribution: the printed piece whose QR code produced this lead
  marketingPieceId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  assignedTo     User?           @relation("AssignedLeads", fields: [assignedToUserId], references: [id])
  stormEvent     StormEvent?     @relation(fields: [stormEventId], references: [id])
  job            Job?            @relation("LeadToJob", fields: [jobId], references: [id])
  marketingPiece MarketingPiece? @relation(fields: [marketingPieceId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, status])
}

model Job {
  id              String    @id @default(uuid())
  companyId       String
  leadId          String?
  name            String
  description     String?
  status          JobStatus @default(ACTIVE)
  phase           JobPhase  @default(INSPECTION)
  propertyAddress String
  propertyLatLng  Json?
  startDate       DateTime?
  endDate         DateTime?
  grossProfit     Float?
  budget          Float?
  actualCost      Float?
  estimatedCost   Float?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id])
  lead                     Lead?                     @relation("LeadToJob")
  createdBy                User                      @relation("AssignedJobs", fields: [createdByUserId], references: [id])
  assignedUsers            JobAssignee[]
  estimates                Estimate[]
  calendarEvents           CalendarEvent[]
  feedPosts                FeedPost[]
  documents                Document[]
  materialOrders           MaterialOrder[]
  changeOrders             ChangeOrder[]
  subcontractorAssignments SubcontractorAssignment[]
}

model JobAssignee {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  role      String // CREW_LEAD, INSTALLER, INSPECTOR
  createdAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
}

model Estimate {
  id          String         @id @default(uuid())
  companyId   String
  jobId       String
  name        String
  totalCost   Float          @default(0)
  totalPrice  Float          @default(0)
  status      EstimateStatus @default(DRAFT)
  pdfUrl      String?
  sentAt      DateTime?
  approvedAt  DateTime?
  notes       String?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company      Company        @relation(fields: [companyId], references: [id])
  job          Job            @relation(fields: [jobId], references: [id])
  items        EstimateItem[]
  changeOrders ChangeOrder[]
}

model EstimateItem {
  id          String   @id @default(uuid())
  estimateId  String
  description String
  quantity    Float
  unit        String
  unitCost    Float
  unitPrice   Float
  category    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id])
}

model ChangeOrder {
  id           String    @id @default(uuid())
  companyId    String
  jobId        String
  estimateId   String?
  description  String
  amount       Float
  status       String    @default("PENDING")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company   @relation(fields: [companyId], references: [id])
  job        Job       @relation(fields: [jobId], references: [id])
  estimate   Estimate? @relation(fields: [estimateId], references: [id])
  approvedBy User?     @relation(fields: [approvedById], references: [id])
}

model CalendarEvent {
  id              String    @id @default(uuid())
  companyId       String
  jobId           String?
  title           String
  description     String?
  eventType       EventType @default(OTHER)
  startTime       DateTime
  endTime         DateTime
  allDay          Boolean   @default(false)
  location        String?
  propertyLatLng  Json?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   Company                 @relation(fields: [companyId], references: [id])
  job       Job?                    @relation(fields: [jobId], references: [id])
  createdBy User                    @relation(fields: [createdByUserId], references: [id])
  assignees CalendarEventAssignee[]
  reminders EventReminder[]
}

model CalendarEventAssignee {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id])
  user  User          @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model EventReminder {
  id            String   @id @default(uuid())
  eventId       String
  type          String   @default("NOTIFICATION")
  minutesBefore Int
  createdAt     DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id])
}

// ============================================================
// Communication Models
// ============================================================

model FeedPost {
  id           String   @id @default(uuid())
  jobId        String
  userId       String? // Nullable — system posts have no author
  companyId    String
  content      String?
  parentPostId String?
  isSystem     Boolean  @default(false)
  data         Json?    @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job         Job              @relation(fields: [jobId], references: [id])
  user        User?            @relation(fields: [userId], references: [id])
  company     Company          @relation(fields: [companyId], references: [id])
  parent      FeedPost?        @relation("FeedThread", fields: [parentPostId], references: [id])
  replies     FeedPost[]       @relation("FeedThread")
  attachments FeedAttachment[]
  mentions    FeedMention[]
}

model FeedAttachment {
  id        String   @id @default(uuid())
  postId    String? // Nullable — attachments may be uploaded before a post is created
  userId    String
  companyId String
  fileUrl   String
  fileType  String // IMAGE, DOCUMENT, VIDEO
  fileName  String
  size      Int
  createdAt DateTime @default(now())

  post    FeedPost? @relation(fields: [postId], references: [id])
  user    User      @relation(fields: [userId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])
}

model FeedMention {
  id        String   @id @default(uuid())
  postId    String
  userId    String // The user being mentioned
  createdAt DateTime @default(now())

  post FeedPost @relation(fields: [postId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

// ============================================================
// Document Models
// ============================================================

model Document {
  id               String   @id @default(uuid())
  companyId        String
  jobId            String?
  name             String
  fileUrl          String
  fileType         String // CONTRACT, PERMIT, INVOICE, PHOTO, ESTIMATE_PDF, OTHER
  size             Int?
  metadata         Json?    @default("{}") // e.g. annotations: [], tags, description
  uploadedByUserId String
  createdAt        DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id])
  job        Job?    @relation(fields: [jobId], references: [id])
  uploadedBy User    @relation(fields: [uploadedByUserId], references: [id])
}

// ============================================================
// Notification Model
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  companyId String
  userId    String
  type      NotificationType
  title     String
  body      String?
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ============================================================
// Integration Model
// ============================================================

model Integration {
  id           String            @id @default(uuid())
  companyId    String
  type         IntegrationType
  credentials  Json?
  status       IntegrationStatus @default(PENDING)
  lastSyncedAt DateTime?
  settings     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, type])
}

// ============================================================
// Storm Event Model (reuses NOAA Weather Service data)
// ============================================================

model StormEvent {
  id           String         @id @default(uuid())
  companyId    String
  name         String
  description  String?
  startDate    DateTime
  endDate      DateTime
  severity     SeverityLevel
  eventType    StormEventType
  affectedArea Json?
  // NOAA-sync + map intelligence fields
  externalId   String?
  source       String         @default("MANUAL") // NOAA | MANUAL | IMPORT
  geometry     Json?
  metadata     Json?          @default("{}")
  aiBrief      Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  leads   Lead[]

  @@unique([companyId, externalId])
  @@index([companyId, startDate])
}

// ============================================================
// Price Database Model
// ============================================================

model PriceDatabaseEntry {
  id           String   @id @default(uuid())
  companyId    String
  category     String // SHINGLES, UNDERLAYMENT, LABOR, FLASHING, etc.
  name         String
  unit         String // sq, lf, ea, bn, etc.
  defaultCost  Float?
  defaultPrice Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, category])
}

// ============================================================
// Subcontractor Models
// ============================================================

model Subcontractor {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  phone         String?
  email         String?
  companyName   String?
  licenseNumber String?
  insuranceInfo Json?
  specialties   String[]
  rating        Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company                   @relation(fields: [companyId], references: [id])
  assignments SubcontractorAssignment[]

  @@index([companyId, name])
}

model SubcontractorAssignment {
  id              String   @id @default(uuid())
  jobId           String
  subcontractorId String
  userId          String?
  assignedAt      DateTime @default(now())
  notes           String?

  job           Job           @relation(fields: [jobId], references: [id])
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])

  @@unique([jobId, subcontractorId])
}

// ============================================================
// Material Order Models
// ============================================================

model MaterialOrder {
  id             String         @id @default(uuid())
  companyId      String
  jobId          String
  supplierName   String
  status         MaterialStatus @default(PENDING)
  totalCost      Float?
  orderedAt      DateTime?
  deliveredAt    DateTime?
  trackingNumber String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company         Company             @relation(fields: [companyId], references: [id])
  job             Job                 @relation(fields: [jobId], references: [id])
  items           MaterialOrderItem[]
  orderedByUserId String?
  orderedBy       User?               @relation(fields: [orderedByUserId], references: [id])
}

model MaterialOrderItem {
  id              String @id @default(uuid())
  materialOrderId String
  name            String
  quantity        Float
  unit            String
  unitCost        Float
  totalCost       Float

  order MaterialOrder @relation(fields: [materialOrderId], references: [id])
}

// ============================================================
// AI Gateway Models — FreeLLMAPI-compatible multi-provider router
// ============================================================

model AIProvider {
  id           String   @id @default(uuid())
  providerId   String   @unique // groq | google | cerebras | mistral | openrouter | nvidia | freellmapi | custom
  name         String
  kind         String   @default("remote") // remote | gateway | local
  baseUrl      String?
  apiKeyCipher String? // AES-256-GCM ciphertext — never returned by the API
  enabled      Boolean  @default(true)
  priority     Int      @default(100) // lower = tried first in the fallback chain
  models       String[] @default([])
  limits       Json?    @default("{}") // { rpm, rpd, tpm, tpd }
  health       Json?    @default("{}") // { status, lastCheckAt, latencyMs, error, model }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AIUsage {
  id               String   @id @default(uuid())
  companyId        String
  userId           String?
  providerId       String?
  model            String?
  purpose          String   @default("chat") // storm_brief | map_copilot | lead_insights | chat
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int      @default(0)
  status           String   @default("SUCCESS") // SUCCESS | FALLBACK | ERROR
  fallback         Boolean  @default(false)
  error            String?
  createdAt        DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([purpose, createdAt])
}

model AISetting {
  id        String   @id @default("global")
  companyId String?  @unique
  routing   Json     @default("{}") // { strategy, stickyMinutes, allowLocalFallback }
  features  Json     @default("{}") // { stormBrief, mapCopilot, leadInsights, chat }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Field Hub (operator queue) ───────────────────────────────────────────
enum FieldQueueStatus {
  QUEUED
  SCHEDULED
  IN_PROGRESS
  SEALED
  SUBMITTED
}

model FieldQueueItem {
  id            String           @id @default(uuid())
  companyId     String
  userId        String
  jobId         String
  status        FieldQueueStatus @default(QUEUED)
  position      Int              @default(0)
  proposedPrice Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status, position])
  @@index([companyId])
}

model FieldOperatorProfile {
  id                String    @id @default(uuid())
  companyId         String
  userId            String    @unique
  w9Status          String    @default("UNSUBMITTED")
  agreementHash     String?
  agreementSignedAt DateTime?
  tools             String[]  @default([])
  serviceRadiusKm   Int       @default(50)
  devicePaired      Boolean   @default(false)
  pairingCode       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId])
}

model FieldEvidencePacket {
  id            String   @id @default(uuid())
  companyId     String
  userId        String
  jobId         String
  queueItemId   String?
  code          String
  title         String
  consentName   String
  consentRole   String
  consentScope  String
  consentMethod String   @default("IN_APP_SIGNATURE")
  consentHash   String
  consentAt     DateTime
  recordsJson      Json
  headHash         String
  merkleLeaf       String
  c2paManifestJson Json?
  rekorAnchorJson  Json?
  tier             Int      @default(5)
  sealState     String   @default("EARNED")
  demo          Boolean  @default(true)
  sealedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([userId, sealedAt])
  @@index([companyId, jobId])
}

model FieldLedgerEntry {
  id             String   @id @default(uuid())
  companyId      String
  userId         String
  jobId          String?
  packetId       String?
  kind           String
  amountCents    Int
  status         String
  description    String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([companyId])
}

// ============================================================
// Sprint 4: AUCTUM Spaces, Social Feed & Live Streaming
// ============================================================

model FieldSpace {
  id           String   @id @default(uuid())
  companyId    String
  slug         String
  name         String
  tagline      String?
  district     String?
  roleLabel    String   @default("Territory")
  coverUrl     String?
  lat          Float?
  lng          Float?
  stormEventId String?
  jobId        String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  follows      FieldSpaceFollow[]
  posts        FieldSocialPost[]
  liveSessions FieldLiveSession[]

  @@unique([companyId, slug])
  @@index([companyId, createdAt])
}

model FieldSpaceFollow {
  id        String   @id @default(uuid())
  spaceId   String
  userId    String
  companyId String
  createdAt DateTime @default(now())

  space FieldSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId, companyId])
}

model FieldSocialPost {
  id        String   @id @default(uuid())
  companyId String
  spaceId   String?
  authorId  String
  kind      String   @default("NOTE") // NOTE | LOT_HANDOFF | LIVE_CLIP
  title     String?
  body      String
  jobId     String?
  mediaUrls Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space   FieldSpace?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  replies FieldSocialReply[]
  keeps   FieldSocialKeep[]

  @@index([companyId, createdAt])
  @@index([spaceId, createdAt])
}

model FieldSocialReply {
  id        String   @id @default(uuid())
  postId    String
  companyId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post FieldSocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model FieldSocialKeep {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  companyId String
  createdAt DateTime @default(now())

  post FieldSocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, companyId])
}

model FieldLiveSession {
  id             String    @id @default(uuid())
  companyId      String
  spaceId        String?
  hostUserId     String
  title          String
  status         String    @default("LIVE") // LIVE | ENDED
  transport      String    @default("FRAME_RELAY") // WEBRTC | FRAME_RELAY
  viewerCount    Int       @default(1)
  latestFrameUrl String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  space FieldSpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  @@index([companyId, status, startedAt])
}

// ============================================================
// Marketing Studio (AUCTUM pattern: branded print pieces with a
// scannable link; every scan-to-lead is attributed to its piece)
// ============================================================

enum MarketingPieceKind {
  YARD_SIGN
  DOOR_HANGER
  FLYER
  POSTCARD
  TRUCK_MAGNET
}

model MarketingCampaign {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  stormEventId String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id])
  pieces  MarketingPiece[]

  @@index([companyId, createdAt])
}

model MarketingPiece {
  id          String             @id @default(uuid())
  companyId   String
  campaignId  String
  kind        MarketingPieceKind
  title       String
  headline    String
  body        String             @default("")
  cta         String             @default("")
  // Brand snapshot used when the piece was printed (colors), so later brand edits never change history
  design      Json               @default("{}")
  // Public short code printed in the QR link (/m/<code>); unguessable, unique
  code        String             @unique
  scanCount   Int                @default(0)
  lastScanAt  DateTime?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company  Company           @relation(fields: [companyId], references: [id])
  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@index([companyId, campaignId])
}

// ============================================================
// AUCTUM Vanguard — Career Academy, H3 Batch Dispatch,
// Earn-to-Learn Vault, Immutable Audit Chain, DePIN & Anti-Spoofing
// ============================================================

model OperatorCredential {
  id              String   @id @default(uuid())
  companyId       String
  userId          String
  credentialCode  String
  tierLevel       Int      @default(1)
  earnedViaModule String?
  instructorId    String?
  licenseNumber   String?
  grantedAt       DateTime @default(now())

  @@unique([userId, credentialCode])
  @@index([companyId, userId])
}

model VanguardModuleProgress {
  id               String    @id @default(uuid())
  companyId        String
  userId           String
  moduleCode       String
  status           String    @default("COMPLETED")
  instructorUserId String?
  completedAt      DateTime  @default(now())

  @@unique([userId, moduleCode])
  @@index([companyId, userId])
}

model VanguardTask {
  id                    String    @id @default(uuid())
  companyId             String
  verticalCode          String    // V-0A, V-0B, V-01..V-08
  surface               String    // helios.local.b2c | vanguard.b2b.bounty | facet | atlas
  title                 String
  description           String    @default("")
  address               String
  lat                   Float
  lng                   Float
  h3Index               String
  requiredTier          Int       @default(1)
  requiredCredential    String?
  isFloorTask           Boolean   @default(false)
  grossBountyCents      Int
  buyerFeeBps           Int       @default(500)
  buyerFeeCents         Int
  estimatedMinutes      Int       @default(25)
  status                String    @default("AVAILABLE") // AVAILABLE | CLAIMED | PIN_CONFIRMED | SEALED | PAID | EXPIRED
  claimedByUserId       String?
  requesterName         String?
  familyProxyName       String?
  completionPinHash     String?
  completionPinPreview  String?   // Non-production staging display for demo senior handshake
  pinConfirmedAt        DateTime?
  consentOptInTelemetry Boolean   @default(true)
  stormEventId          String?
  telemetryPayload      Json?
  expiresAt             DateTime?
  claimedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId, status, h3Index])
  @@index([companyId, verticalCode])
}

model EarnToLearnVault {
  id                    String   @id @default(uuid())
  companyId             String
  userId                String   @unique
  routingBps            Int      @default(1000) // 10.00% default optional routing
  balanceCents          Int      @default(0)
  totalContributedCents Int      @default(0)
  redeemedGear          Json     @default("[]")
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([companyId])
}

model AuditLedgerEntry {
  id           String   @id @default(uuid())
  companyId    String
  subjectRef   String
  seq          Int
  kind         String   // CAPTURE | ATTEST | CUSTODY | INSPECTION | PAYMENT | CORRECTION
  actorId      String
  payload      Json
  prevHash     String
  rowHash      String
  merkleHeadId String?
  createdAt    DateTime @default(now())

  @@unique([subjectRef, seq])
  @@index([companyId, subjectRef])
}

model MerkleTreeHead {
  id             String   @id @default(uuid())
  companyId      String
  treeSize       Int
  rootHash       String
  leafHashesJson Json
  anchoredAt     DateTime @default(now())

  @@index([companyId, anchoredAt])
}

model SpatialAsset {
  id                  String    @id @default(uuid())
  companyId           String
  h3Index             String
  address             String
  lat                 Float
  lng                 Float
  capturerUserId      String
  homeownerLabel      String?
  homeownerOptIn      Boolean   @default(true)
  packetId            String?
  capturedAt          DateTime  @default(now())
  queryCount          Int       @default(0)
  totalRoyaltiesCents Int       @default(0)
  lastQueriedAt       DateTime?

  royalties DataRoyaltyEvent[]

  @@index([companyId, h3Index])
}

model DataRoyaltyEvent {
  id                    String   @id @default(uuid())
  assetId               String
  companyId             String
  buyerName             String
  queryPriceCents       Int
  workerRoyaltyCents    Int
  homeownerRoyaltyCents Int
  treasuryBurnCents     Int
  ageDaysAtQuery        Int
  createdAt             DateTime @default(now())

  asset SpatialAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
}

model HardwareVaultPool {
  id                     String   @id @default(uuid())
  companyId              String
  name                   String
  category               String   // FLIR_THERMAL | UAV_PART_107 | LIDAR_RIG | ELECTRIC_MOWER
  unitCostCents          Int
  totalShares            Int      @default(100)
  fundedShares           Int      @default(25)
  yieldShareBps          Int      @default(800)
  activeCheckoutUserId   String?
  totalYieldEarnedCents  Int      @default(0)
  createdAt              DateTime @default(now())

  shares HardwareVaultShare[]

  @@index([companyId])
}

model HardwareVaultShare {
  id               String   @id @default(uuid())
  poolId           String
  companyId        String
  userId           String
  shares           Int      @default(1)
  yieldEarnedCents Int      @default(0)
  createdAt        DateTime @default(now())

  pool HardwareVaultPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([companyId, userId])
}

model DeviceAttestationNonce {
  id                String    @id @default(uuid())
  nonce             String    @unique
  companyId         String
  userId            String
  subjectRef        String
  verdict           String?   // MEETS_STRONG_INTEGRITY | MEETS_DEVICE_INTEGRITY | FLAGGED
  keyboxSerial      String?
  imuJitterVariance Float?
  flagged           Boolean   @default(false)
  flagReason        String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([companyId, userId])
}

