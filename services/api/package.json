{
  "name": "@vanguard/api",
  "version": "1.0.0",
  "description": "Vanguard Platform API - Evidence Engine, H3 Micro-Zone Dispatch, DePIN & Field Operations",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch --tsconfig tsconfig.json src/server.ts",
    "build": "tsc --noEmit && tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx --watch --tsconfig tsconfig.json src/server.ts",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma db drop --force && prisma db push",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.1.2",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.0.1",
    "h3-js": "^4.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.13.0",
    "socket.io": "^4.7.5",
    "winston": "^3.13.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.10.0",
    "typescript": "^5.5.0"
  }
}
